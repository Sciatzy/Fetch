<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_information"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/brand_ink"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_subtitle"
            android:textColor="@color/text_grey"
            android:textSize="13sp"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivProfileAvatar"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_avatar_circle"
                android:padding="2dp"
                android:contentDescription="@string/profile_title"
                android:scaleType="centerCrop"
                android:src="@drawable/fetch_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_email_placeholder"
                    android:textColor="@color/text_grey"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnChangePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/profile_change_photo"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_secondary"
                    app:backgroundTint="@null"
                    android:textColor="@color/brand_red"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_security_note"
            android:textColor="@color/text_grey"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etProfileName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_rounded"
            android:paddingHorizontal="16dp"
            android:hint="@string/hint_full_name"
            android:inputType="textPersonName"
            android:autofillHints="name"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etProfilePhone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_rounded"
            android:paddingHorizontal="16dp"
            android:hint="@string/profile_phone_hint"
            android:inputType="phone"
            android:autofillHints="phone"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSaveProfileChanges"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/profile_save_changes"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            app:backgroundTint="@null"
            android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>

