<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_gray">

    <!-- Header matching modern styling -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="32dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fetch_logo"
                android:padding="8dp"
                android:contentDescription="@string/app_name" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rider_feed_title"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/brand_ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rider_feed_subtitle"
                android:textSize="15sp"
                android:textColor="@color/text_grey"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_pending_tasks"
            android:textColor="@color/text_grey"
            android:textSize="15sp"
            android:gravity="center"
            android:background="@drawable/bg_card_white"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:padding="32dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressTaskFeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvErrorState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="15sp"
                android:textColor="@color/brand_ink"
                android:background="@drawable/bg_card_white"
                android:padding="32dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnRetryFeed"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_secondary"
                app:backgroundTint="@null"
                android:textColor="@color/brand_red"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:text="@string/retry"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPendingTasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="100dp" />

    </FrameLayout>
</LinearLayout>
