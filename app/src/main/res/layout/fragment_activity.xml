<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <!-- Header matching new modern spacing/typography -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="32dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            
            app:cardBackgroundColor="#E6FFFFFF"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:padding="8dp"
                android:src="@drawable/fetch_logo" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:id="@+id/tvActivityHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_activity"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvActivityEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activity_empty_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:gravity="center"
            android:background="@drawable/bg_card_white"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:padding="32dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvActivityTasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="100dp" />
    </FrameLayout>
</LinearLayout>
