<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <!-- Red Gradient Header Area -->
    <View
        android:id="@+id/vRedHeaderBg"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#D32F2F"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Rewards"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Your Points"
                android:textColor="#FFCDD2"
                android:textSize="14sp" />
                
            <TextView
                android:id="@+id/tvTotalPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15.5"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Earn 0.5 points for every ₱50.00 spent!"
                android:textColor="#FFCDD2"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Redeem Points"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Applicable for Shipping Fee discounts only."
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <!-- 10% Discount -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10% OFF"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#D32F2F" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Costs 10 points"
                                android:textSize="14sp"
                                android:textColor="#757575"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnRedeem10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Redeem"
                            app:cornerRadius="20dp"
                            app:backgroundTint="#D32F2F"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 20% Discount -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="20% OFF"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#D32F2F" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Costs 20 points"
                                android:textSize="14sp"
                                android:textColor="#757575"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                        
                        <Button
                            android:id="@+id/btnRedeem20"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Redeem"
                            app:cornerRadius="20dp"
                            app:backgroundTint="#D32F2F"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                
                <!-- 50% Discount -->
                 <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="50% OFF"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#D32F2F" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Costs 50 points"
                                android:textSize="14sp"
                                android:textColor="#757575"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                        
                        <Button
                            android:id="@+id/btnRedeem50"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Redeem"
                            app:cornerRadius="20dp"
                            app:backgroundTint="#D32F2F"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>