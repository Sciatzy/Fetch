<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_white"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvRiderName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/brand_ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRiderEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_grey"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvRiderVehicle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/brand_ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvRiderLicense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/brand_ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvRiderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_grey"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnDeactivateRider"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_secondary"
        app:backgroundTint="@null"
        android:text="@string/admin_deactivate"
        android:textAllCaps="false"
        android:textColor="@color/brand_red"
        android:textStyle="bold" />

</LinearLayout>
