<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray">

    <!-- Map View fills the screen -->
    <org.osmdroid.views.MapView
        android:id="@+id/trackingMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top floating Banner: Status Display -->
    <androidx.cardview.widget.CardView
        android:id="@+id/statusBannerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF">

            <!-- Title & User Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/fetch_logo"
                    android:background="@drawable/bg_avatar_circle"
                    android:padding="4dp"
                    android:contentDescription="@string/app_name" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tvTrackingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tracking_title"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tracking_subtitle"
                        android:textColor="#757575"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="12dp" />

            <!-- Dynamic Status Content -->
            <TextView
                android:id="@+id/tvTrackingStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/loading"
                android:textColor="#2196F3"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="4dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvCollectHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/tracking_collect_hint_default"
                android:textColor="#757575"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Action Panel (Workflow Buttons) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/workflowActionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Scrollable just in case screen is terribly small -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF">

                <!-- Navigation buttons formatted as secondary -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnNavigatePickup"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="@string/tracking_navigate_pickup"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_input_rounded"
                        app:backgroundTint="#FAFAFA"
                        android:textColor="#4CAF50" />

                    <Button
                        android:id="@+id/btnNavigateDropoff"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="@string/tracking_navigate_dropoff"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_input_rounded"
                        app:backgroundTint="#FAFAFA"
                        android:textColor="#F44336" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCallCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/tracking_call_customer"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:background="@drawable/bg_input_rounded"
                    app:backgroundTint="#FAFAFA"
                    android:textColor="#757575"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="12dp" />

                <!-- Primary Progress Workflow Buttons -->
                <!-- Note: The Java code handles visibility manually for these -->
                <Button
                    android:id="@+id/btnArrivedDestination"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/tracking_arrived_destination"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_primary"
                    app:backgroundTint="#FF9800"
                    android:textColor="@color/white"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnCompleteAndCollect"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/tracking_complete_collect"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_primary"
                    app:backgroundTint="#4CAF50"
                    android:textColor="@color/white" />

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

