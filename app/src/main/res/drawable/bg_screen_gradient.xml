<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="225"
                android:startColor="#E6EEF8"
                android:centerColor="#D9E4F1"
                android:endColor="#CBDCE8"
                android:type="linear" />
        </shape>
    </item>
    <item android:bottom="500dp" android:left="-150dp" android:right="200dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="400"
                android:startColor="#1A2C43F6"
                android:endColor="#002C43F6" />
        </shape>
    </item>
    <item android:top="500dp" android:left="150dp" android:right="-150dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="600"
                android:startColor="#1AE51D27"
                android:endColor="#00E51D27" />
        </shape>
    </item>
</layer-list>
